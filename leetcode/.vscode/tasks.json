{
  // Scripts run through cmd.exe directly (type: "process") rather than the
  // terminal's shell, to avoid both the GBK decoding of UTF-8 output and the
  // conflicts of a shell profile that uses -Command.
  //
  // problemMatcher is $gcc, not $msCompile: the build now goes through
  // clang++/lld, and $gcc is the matcher that understands clang's
  // "file:line:col: error: message" diagnostics.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "lc: build current file",
      "type": "process",
      "command": "cmd",
      "args": ["/c", "scripts\\lc-build.cmd", "${relativeFile}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "lc: build & run current file",
      "type": "process",
      "command": "cmd",
      "args": ["/c", "scripts\\lc.cmd", "${relativeFile}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
