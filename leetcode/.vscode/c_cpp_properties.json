{
  // No compile database here (files are built ad-hoc with scripts/lc.cmd),
  // so IntelliSense is configured directly for MSVC + C++23.
  "version": 4,
  "configurations": [
    {
      "name": "Win32",
      "includePath": ["${workspaceFolder}/**"],
      "defines": ["_DEBUG", "UNICODE", "_UNICODE"],
      "compilerPath": "cl.exe",
      "cStandard": "c17",
      "cppStandard": "c++23",
      "intelliSenseMode": "windows-msvc-x64"
    }
  ]
}
